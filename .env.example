# Copy this file to .env locally. Never commit .env or share Azure account keys.
# Replace this demonstration password before running Docker Compose.
# Use a strong value (uppercase, lowercase, number and symbol).
MSSQL_SA_PASSWORD=ChangeThisToAStrongLocalPassword123!

# Leave blank to run the app without image uploads (CI smoke test).
# For REAL image upload/display, paste your Azure Storage CONNECTION STRING locally.
# No Azurite service is included in this Compose stack.
AZURE_BLOB_CONNECTION_STRING=

# Only set if your API's organiser registration configuration uses it.
ORGANISER_CODE=

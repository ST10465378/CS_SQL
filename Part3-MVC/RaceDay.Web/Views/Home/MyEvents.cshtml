@model List<EnrolmentInfo>
@{ViewData["Title"]="My events";}<p class="eyebrow">PARTICIPANT ZONE</p><h1>My <em>events.</em></h1><div class="table-responsive"><table class="table table-dark table-hover"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Bib</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.EventName</td><td>@e.EventDate</td><td>@e.CategoryName</td><td>@e.BibNumber</td><td><span class="status @(e.PaymentStatus=="paid"?"confirmed":"pending")">@e.PaymentStatus</span></td><td><form asp-action="Withdraw" method="post"><input type="hidden" name="id" value="@e.EnrolmentId"><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Withdraw from this event?')">Withdraw</button></form></td></tr>}</tbody></table></div>@if(Model.Count==0){<div class="empty-state">You're not registered for an event yet. <a asp-action="Index">Find your first race.</a></div>}

@model List<EventInfo>
@{ViewData["Title"]="Find your next race";}<section class="hero"><p class="eyebrow">THE STARTING LINE IS YOURS</p><h1>CHASE THE <em>FINISH LINE.</em></h1><p class="lead text-secondary">Discover races, challenges and unforgettable moments. Find your next start line.</p><a href="#events" class="btn btn-brand btn-lg">Find your race ↗</a></section><div id="events" class="d-flex justify-content-between align-items-end mb-3"><div><p class="eyebrow">UPCOMING EVENTS</p><h2>What's coming up</h2></div></div><form method="get" class="row g-2 mb-4"><div class="col-md-7"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search races or locations"></div><div class="col-md-3"><select name="eventType" class="form-select"><option value="">All sports</option><option value="run">Running</option><option value="walk">Walking</option><option value="cycle">Cycling</option></select></div><div class="col-md-2"><button class="btn btn-brand w-100">Filter</button></div></form>@if(ViewBag.Error!=null){<p class="alert alert-warning">@ViewBag.Error</p>}<div class="row g-4">@foreach(var ev in Model){<div class="col-md-6 col-lg-4"><div class="event-card">@if(!string.IsNullOrWhiteSpace(ev.BannerImageUrl)){<img src="@ev.BannerImageUrl" class="event-banner" alt="Event banner"/>}else{<div class="event-banner placeholder-banner">@ev.EventType.ToUpperInvariant()</div>}<div class="p-4"><span class="eyebrow">@ev.EventType.ToUpperInvariant() · @ev.DistanceKm KM</span><h3>@ev.Name</h3><p class="text-secondary">⌖ @ev.Location<br>◷ @ev.EventDate</p><a asp-action="Event" asp-route-id="@ev.EventId" class="btn btn-outline-light w-100">View event →</a></div></div></div>}</div>@if(Model.Count==0){<div class="empty-state">No upcoming events found. Try another filter.</div>}

@model EventInfo
@{ViewData["Title"]=Model.Name;}<a asp-action="Index" class="text-secondary">← All events</a>@if(!string.IsNullOrWhiteSpace(Model.BannerImageUrl)){<img class="detail-banner mt-4" src="@Model.BannerImageUrl" alt="Event banner"/>}<p class="eyebrow mt-4">@Model.EventType.ToUpperInvariant() · @Model.Status.ToUpperInvariant()</p><h1>@Model.Name</h1><p class="lead text-secondary">@Model.Description</p><div class="stat-strip"><span>⌖ @Model.Location</span><span>◷ @Model.EventDate</span><span>↗ @Model.DistanceKm km</span></div><h2 class="mt-5">Choose your category</h2><div class="row g-3">@foreach(var cat in Model.Categories??new()){<div class="col-md-6"><div class="panel"><h3>@cat.Name</h3><p class="text-secondary">@cat.DistanceKm km · R @cat.EntryFee · @cat.EnrolledCount enrolled @if(cat.MaxParticipants>0){<span>/ @cat.MaxParticipants capacity</span>}</p>@if(Context.Session.GetString("Role")=="Participant"&&Model.Status=="published"){<form asp-action="Enrol" method="post"><input type="hidden" name="categoryId" value="@cat.CategoryId"><input type="hidden" name="eventId" value="@Model.EventId"><button class="btn btn-brand">Enter this category →</button></form>}else if(Context.Session.GetString("Role")==null){<a asp-controller="Account" asp-action="Login" class="btn btn-outline-light">Log in to enrol</a>}</div></div>}</div>

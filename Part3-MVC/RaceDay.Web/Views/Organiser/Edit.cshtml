@model EventForm
@{ViewData["Title"]=ViewBag.EventId==null?"Create event":"Edit event";}<p class="eyebrow">EVENT MANAGEMENT</p><h1>@(ViewBag.EventId==null?"Create an":"Edit your") <em>event.</em></h1><div class="panel col-lg-8"><form asp-action="Save" method="post" enctype="multipart/form-data"><input type="hidden" name="id" value="@ViewBag.EventId"><div asp-validation-summary="All" class="text-danger"></div><label class="form-label">Event name</label><input asp-for="Name" class="form-control mb-3"><label class="form-label">Date</label><input asp-for="EventDate" type="date" class="form-control mb-3"><label class="form-label">Location</label><input asp-for="Location" class="form-control mb-3"><label class="form-label">Description</label><textarea asp-for="Description" class="form-control mb-3" rows="3"></textarea><label class="form-label">Distance (km)</label><input asp-for="DistanceKm" type="number" step="0.01" class="form-control mb-3"><label class="form-label">Sport</label><select asp-for="EventType" class="form-select mb-3"><option value="run">Running</option><option value="walk">Walking</option><option value="cycle">Cycling</option></select><label class="form-label">Status</label><select asp-for="Status" class="form-select mb-3"><option value="draft">Draft</option><option value="published">Published</option><option value="cancelled">Cancelled</option></select><label class="form-label">Event banner (JPG, PNG, WEBP; max 5 MB)</label><input asp-for="Banner" type="file" accept="image/jpeg,image/png,image/webp" class="form-control mb-4"><button class="btn btn-brand">Save event →</button></form></div>

@model List<EventInfo>
@{ViewData["Title"]="Organiser dashboard";}<p class="eyebrow">ORGANISER COMMAND CENTRE</p><h1>Make every <em>race count.</em></h1><p class="text-secondary">Manage your events, entries and results in one place.</p><div class="stat-strip"><div><strong>@Model.Count</strong><small>Events</small></div><div><strong>@Model.Count(x=>x.Status=="published")</strong><small>Published</small></div><div><strong>@Model.Count(x=>x.EventDate.CompareTo(DateTime.Today.ToString("yyyy-MM-dd"))>=0)</strong><small>Upcoming</small></div></div><div class="d-flex justify-content-between align-items-center mt-5 mb-3"><h2>My events</h2><a class="btn btn-brand" asp-action="Create">+ Create event</a></div><div class="row g-3">@foreach(var e in Model){<div class="col-md-6"><div class="panel"><span class="eyebrow">@e.Status.ToUpperInvariant() · @e.EventType.ToUpperInvariant()</span><h3>@e.Name</h3><p class="text-secondary">@e.EventDate · @e.Location</p><p class="text-secondary">@((ViewBag.EnrolmentCounts as Dictionary<int,int>)?.GetValueOrDefault(e.EventId).ToString() ?? "—") total enrolments</p><a class="btn btn-outline-light" asp-action="Details" asp-route-id="@e.EventId">Manage event →</a></div></div>}</div>

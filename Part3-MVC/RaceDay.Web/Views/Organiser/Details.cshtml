@model EventInfo
@{ViewData["Title"]="Manage " + Model.Name;}<a asp-action="Index" class="text-secondary">← Dashboard</a><p class="eyebrow mt-4">@Model.Status.ToUpperInvariant()</p><div class="d-flex align-items-center justify-content-between flex-wrap gap-3"><h1>@Model.Name</h1><div><a class="btn btn-outline-light" asp-action="Edit" asp-route-id="@Model.EventId">Edit event</a><form class="d-inline" asp-action="Delete" method="post"><input type="hidden" name="id" value="@Model.EventId"><button class="btn btn-outline-danger" onclick="return confirm('Delete this event?')">Delete</button></form></div></div>@if(!string.IsNullOrWhiteSpace(Model.BannerImageUrl)){<img src="@Model.BannerImageUrl" alt="Event banner" class="detail-banner"/>}<div class="stat-strip mt-3"><span>@Model.EventDate</span><span>@Model.Location</span><span>@Model.DistanceKm km</span></div><h2 class="mt-5">Race categories</h2><div class="row g-3">@foreach(var cat in Model.Categories??new()){<div class="col-md-6"><div class="panel"><h3>@cat.Name</h3><p class="text-secondary">@cat.DistanceKm km · @cat.EnrolledCount entries · R @cat.EntryFee</p><details class="my-3"><summary class="text-info" style="cursor:pointer">Edit category</summary><form asp-action="UpdateCategory" method="post" class="row g-2 mt-2"><input type="hidden" name="eventId" value="@Model.EventId"/><input type="hidden" name="id" value="@cat.CategoryId"/><div class="col-md-6"><label class="form-label">Name</label><input class="form-control" name="Name" value="@cat.Name" required/></div><div class="col-md-6"><label class="form-label">Distance (km)</label><input class="form-control" name="DistanceKm" type="number" min="0.01" step="0.01" value="@cat.DistanceKm" required/></div><div class="col-md-6"><label class="form-label">Capacity (0 = unlimited)</label><input class="form-control" name="MaxParticipants" type="number" min="0" value="@cat.MaxParticipants" required/></div><div class="col-md-6"><label class="form-label">Entry fee (R)</label><input class="form-control" name="EntryFee" type="number" min="0" step="0.01" value="@cat.EntryFee" required/></div><div><button class="btn btn-brand btn-sm">Save category</button></div></form></details><a class="btn btn-brand" asp-action="Enrolments" asp-route-eventId="@Model.EventId" asp-route-categoryId="@cat.CategoryId">Entries & results →</a><form asp-action="DeleteCategory" method="post" class="d-inline"><input type="hidden" name="eventId" value="@Model.EventId"><input type="hidden" name="id" value="@cat.CategoryId"><button class="btn btn-outline-danger" onclick="return confirm('Delete category?')">Delete</button></form></div></div>}</div><h2 class="mt-5">Add category</h2><form asp-action="Category" method="post" class="panel row g-3"><input type="hidden" name="eventId" value="@Model.EventId"><div class="col-md-6"><label class="form-label">Category name</label><input name="Name" required class="form-control" placeholder="10 km race"></div><div class="col-md-6"><label class="form-label">Distance (km)</label><input name="DistanceKm" type="number" step="0.01" min="0.01" required class="form-control"></div><div class="col-md-6"><label class="form-label">Maximum participants (0 = unlimited)</label><input name="MaxParticipants" type="number" min="0" class="form-control" value="0"></div><div class="col-md-6"><label class="form-label">Entry fee (R)</label><input name="EntryFee" type="number" min="0" step="0.01" class="form-control" value="0"></div><div><button class="btn btn-brand">+ Add category</button></div></form>

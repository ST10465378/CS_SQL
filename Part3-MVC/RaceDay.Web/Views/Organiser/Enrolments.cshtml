@model List<EnrolmentInfo>
@{ViewData["Title"]="Enrolments & results";}<a asp-action="Details" asp-route-id="@ViewBag.EventId" class="text-secondary">← Back to event</a><p class="eyebrow mt-4">RACE MANAGEMENT</p><h1>Entries & <em>results.</em></h1><p class="text-secondary">@Model.Count registered participants. Capture results after the race.</p>@if(ViewBag.ResultsError!=null){<div class="alert alert-warning">Could not load existing results.</div>}<div class="table-responsive"><table class="table table-dark"><thead><tr><th>Bib</th><th>Participant</th><th>Category</th><th>Payment</th><th>Finish time / position</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.BibNumber</td><td>@e.ParticipantName</td><td>@e.CategoryName</td><td><span class="status @(e.PaymentStatus=="paid"?"confirmed":"pending")">@e.PaymentStatus</span></td><td>@{ var existing = (ViewBag.Results as Dictionary<int,ResultInfo>)?.GetValueOrDefault(e.EnrolmentId); }@if(existing != null){<span class="status confirmed">Recorded: @existing.FinishTime · Position @(existing.Position?.ToString()??"—")</span>}else{<form asp-action="Result" method="post" class="d-flex gap-2 flex-wrap"><input type="hidden" name="eventId" value="@ViewBag.EventId"><input type="hidden" name="categoryId" value="@ViewBag.CategoryId"><input type="hidden" name="enrolmentId" value="@e.EnrolmentId"><input name="finishTime" placeholder="00:28:45" pattern="[0-9]{2}:[0-9]{2}:[0-9]{2}" required class="form-control form-control-sm" style="max-width:130px"><input name="position" type="number" min="1" placeholder="Position" class="form-control form-control-sm" style="max-width:105px"><button class="btn btn-brand btn-sm">Record</button></form>}</td></tr>}</tbody></table></div>

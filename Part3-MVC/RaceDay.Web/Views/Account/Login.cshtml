@model LoginForm
@{ViewData["Title"]="Log in";}<div class="auth-panel"><p class="eyebrow">WELCOME BACK</p><h1>Ready, set, <em>go.</em></h1><p class="text-secondary">Log in to access your RaceDay journey.</p><form asp-action="Login" method="post"><div asp-validation-summary="All" class="text-danger"></div><label class="form-label">Email</label><input asp-for="Email" class="form-control mb-3" type="email"><label class="form-label">Password</label><input asp-for="Password" type="password" class="form-control mb-4"><button class="btn btn-brand w-100">Log in →</button></form><p class="mt-4">New here? <a asp-action="Register">Create an account</a></p></div>

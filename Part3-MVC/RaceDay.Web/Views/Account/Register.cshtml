@model RegisterForm
@{ViewData["Title"]="Register";}<div class="auth-panel"><p class="eyebrow">JOIN THE MOVEMENT</p><h1>Create your <em>account.</em></h1><form asp-action="Register" method="post"><div asp-validation-summary="All" class="text-danger"></div><label class="form-label">Full name</label><input asp-for="FullName" class="form-control mb-3"><label class="form-label">Email</label><input asp-for="Email" type="email" class="form-control mb-3"><label class="form-label">Password (8+ characters)</label><input asp-for="Password" type="password" class="form-control mb-3"><label class="form-label">Your role</label><select asp-for="Role" class="form-select mb-3" id="role"><option>Participant</option><option>Organiser</option></select><div id="organiserFields"><label class="form-label">Organisation</label><input asp-for="OrganisationName" class="form-control mb-3"><label class="form-label">Contact phone</label><input asp-for="ContactPhone" class="form-control mb-3"><label class="form-label">Organiser registration code (if required)</label><input asp-for="OrganiserCode" class="form-control mb-3"></div><div id="participantFields"><label class="form-label">Date of birth</label><input asp-for="DateOfBirth" type="date" class="form-control mb-3"><label class="form-label">Emergency contact</label><input asp-for="EmergencyContact" class="form-control mb-3"></div><button class="btn btn-brand w-100">Create account →
</button></form></div>
@section Scripts {<script>const r=document.querySelector('#role');function toggle(){document.querySelector('#organiserFields').hidden=r.value!=='Organiser';document.querySelector('#participantFields').hidden=r.value!=='Participant'}r.addEventListener('change',toggle);toggle()</script>}

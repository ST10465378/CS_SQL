<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"] · RaceDay</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"></head><body><nav class="navbar navbar-expand-lg navbar-dark sticky-top"><div class="container"><a class="navbar-brand fw-black" asp-controller="Home" asp-action="Index">◆ RACE<span>DAY</span></a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><div class="navbar-nav ms-auto align-items-lg-center gap-lg-2"><a class="nav-link" asp-controller="Home" asp-action="Index">Explore events</a>@if(Context.Session.GetString("Role")=="Organiser"){<a class="nav-link" asp-controller="Organiser" asp-action="Index">Dashboard</a><a class="nav-link" asp-controller="Organiser" asp-action="Create">Create event</a>}@if(Context.Session.GetString("Role")=="Participant"){<a class="nav-link" asp-controller="Home" asp-action="MyEvents">My events</a><a class="nav-link" asp-controller="Home" asp-action="MyResults">My results</a>}@if(Context.Session.GetString("Role")!=null){<a class="nav-link" asp-controller="Profile" asp-action="Index">Profile</a><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm">Log out</button></form>}else{<a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a><a class="btn btn-brand btn-sm" asp-controller="Account" asp-action="Register">Join RaceDay</a>}</div></div></div></nav><main class="container py-5">@if(TempData["Error"]!=null){<div class="alert alert-danger">@TempData["Error"]</div>}@if(TempData["Success"]!=null){<div class="alert alert-success">@TempData["Success"]</div>}@RenderBody()</main><footer class="container py-4 text-secondary border-top border-secondary">RACEDAY • Every finish line starts somewhere.</footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts", required:false)</body></html>

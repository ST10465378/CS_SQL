@model ProfileForm
@{ViewData["Title"]="My profile";}<p class="eyebrow">YOUR ACCOUNT</p><h1>My <em>profile.</em></h1><div class="panel col-lg-8">@if(ViewBag.Picture!=null){<img src="@ViewBag.Picture" class="profile-image mb-3" alt="Profile picture"/>}<p class="text-secondary">@ViewBag.Email</p><form asp-action="Save" method="post" enctype="multipart/form-data"><div asp-validation-summary="All" class="text-danger"></div><label class="form-label">Full name</label><input asp-for="FullName" class="form-control mb-3">@if(Context.Session.GetString("Role")=="Organiser"){<label class="form-label">Organisation</label><input asp-for="OrganisationName" class="form-control mb-3"><label class="form-label">Phone</label><input asp-for="ContactPhone" class="form-control mb-3">}else{<label class="form-label">Date of birth</label><input asp-for="DateOfBirth" type="date" class="form-control mb-3"><label class="form-label">Emergency contact</label><input asp-for="EmergencyContact" class="form-control mb-3">}<label class="form-label">Profile picture (JPG, PNG, WEBP; 5 MB max)</label><input asp-for="Picture" type="file" accept="image/jpeg,image/png,image/webp" class="form-control mb-4"><button class="btn btn-brand">Save changes →</button></form></div>

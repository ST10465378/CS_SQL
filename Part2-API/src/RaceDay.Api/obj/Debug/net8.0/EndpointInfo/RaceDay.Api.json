    "/api/enrolments/{id}": {
      "delete": {
        "tags": [
          "Event Enrolments"
        ],
        "summary": "Withdraw your own enrolment (only before the event takes place).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Enrolment withdrawn."
          },
          "400": {
            "description": "The event has already taken place.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
